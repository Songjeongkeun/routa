# 이 파일은 값의 형식과 설정 방법만 보여 주는 예시입니다.
# 실제 API 키·비밀번호·JWT_SECRET은 절대 커밋하지 말고, 복사한 .env 파일에만 입력하세요.

NODE_ENV=development
HOST_PORT=18765

# OAuth 완료 뒤 돌아올 대표 프론트 주소입니다. 개발 PC, LAN, ngrok 중 한 주소만 지정하세요.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL 이외에 개발 중에 허용할 주소만 쉼표로 추가합니다. '*'는 사용하지 마세요.
# 예: CORS_ALLOWED_ORIGINS=http://192.168.0.10:5173,https://your-subdomain.ngrok-free.dev
CORS_ALLOWED_ORIGINS=

# HTTPS ngrok 주소에서 OAuth 쿠키를 쓸 때 true로 설정합니다.
COOKIE_SECURE=false
VITE_GOOGLE_OAUTH_LOCAL_ENABLED=false

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 로그인·세션
JWT_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_SEC=86400
REFRESH_TOKEN_EXPIRES_DAYS=14
BCRYPT_SALT_ROUNDS=10

# Google OAuth. 콘솔의 승인된 리디렉션 URI와 정확히 같아야 합니다.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:18765/auth/google/callback

# Kakao OAuth / 지도
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_CALLBACK_URL=http://localhost:18765/auth/kakao/callback
VITE_KAKAO_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# ODsay는 Express 서버에서만 사용합니다. VITE_ 접두어를 붙이지 마세요.
ODSAY_SERVER_API_KEY=YOUR_ODSAY_SERVER_KEY
